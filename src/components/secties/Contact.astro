---
// Teksten komen uit het dashboard (met de standaard uit public/teksten.json
// als vangnet). Beeld en opmaak liggen vast.
import { tekst, mailLink, whatsappLink, telLink } from '../../lib/teksten.js';
const { teksten = {}, merkUrl = '/logo-cl.png' } = Astro.props;
const t = (id) => tekst(teksten, id);
---
<!-- CONTACT -->
<section class="pad contact" id="contact" data-sectie="contact">
  <div class="wrap">
    <div class="agent-card">
      <div class="agent-photo"><img src={merkUrl} alt={t('footer_naam')} /></div>
      <div>
        <h3>{t('footer_naam')}</h3>
        <div style="opacity:.85;font-size:.9rem;margin-top:4px">{t('footer_regel')}</div>
      </div>
    </div>
    <div>
      <h2>{t('contact_kop')}</h2>
      <p>{t('contact_tekst1')}</p>
      {t('contact_tekst2') && <p>{t('contact_tekst2')}</p>}
      <div class="btns">
        <a class="btn btn-primary" href={whatsappLink(teksten)}>{t('contact_knop_whatsapp')}</a>
        <a class="btn btn-ghost" href={mailLink(teksten)}>{t('contact_knop_mail')}</a>
        <a class="btn btn-ghost" href={telLink(teksten)}>{t('tel_weergave')}</a>
      </div>
    </div>
  </div>
</section>
