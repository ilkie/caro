---
// Teksten komen uit het dashboard (met de standaard uit public/teksten.json
// als vangnet). Beeld en opmaak liggen vast.
import { tekst, mailLink, whatsappLink, telLink } from '../../lib/teksten.js';
const { teksten = {} } = Astro.props;
const t = (id) => tekst(teksten, id);
---
<!-- OVER CARO -->
<section class="pad about" id="over" data-sectie="over">
  <div class="wrap">
    <div class="ph reveal" style="background:linear-gradient(135deg,var(--accent-deep),var(--sand-deeper))">
      <img class="photo" src="/caro.jpg" alt="Caro Leriche" onerror="this.remove()" />
    </div>
    <div class="reveal">
      <div class="eyebrow">{t('over_eyebrow')}</div>
      <h2>{t('over_kop')}</h2>
      <p>{t('over_tekst1')}</p>
      {t('over_tekst2') && <p>{t('over_tekst2')}</p>}
    </div>
  </div>
</section>
