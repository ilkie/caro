---
// Spotlight + overzicht. Krijgt de woningen en de teksten mee van de homepage.
import { tekst, link, schoneTaal } from '../../lib/teksten.js';
import { woorden } from '../../lib/woorden.js';
import { statusVan, isAfgerond } from '../../lib/status.js';
import { rustigKlasse } from '../../lib/weergave.js';
const { alle = [], teksten = {}, weergave = {}, taal: taalRuw } = Astro.props;
const taal = schoneTaal(taalRuw);
const a = (naar) => link(taal, naar);
const w = woorden(taal);
const t = (id) => tekst(teksten, id);
const uitgelicht = alle.find((w) => w.uitgelicht) || alle[0];
const overige = alle.filter((w) => !uitgelicht || w.slug !== uitgelicht.slug);
const euro = (n) => '€ ' + (n ?? 0).toLocaleString('nl-NL');
// Een cijfer dat niet is ingevuld hoort weg te vallen — anders staat er
// " slk" zonder getal op de kaart.
const cijfer = (n, achter) => (n === null || n === undefined || n === '' || Number(n) <= 0)
  ? null : String(n) + ' ' + achter;
---
<!-- WONINGEN: uitgelicht + overzicht -->
<section class="pad" id="woningen" data-sectie="woningen">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">{t('woningen_eyebrow')}</div>
      <h2>{t('woningen_kop')}</h2>
    </div>

    {uitgelicht && (
      <div class={`spotlight reveal${rustigKlasse(weergave, isAfgerond(uitgelicht.status))}`}>
        <a href={a(`/woning/${uitgelicht.slug}/`)} class="img">
          <img src={uitgelicht.hero} alt={uitgelicht.titel} onerror="this.remove()" />
          {statusVan(uitgelicht.status) && (
            <span class={`badge ${statusVan(uitgelicht.status).klasse}`}>{statusVan(uitgelicht.status).naam}</span>
          )}
        </a>
        <!-- Volgorde in de HTML = leesvolgorde op mobiel; op desktop plaatst
             het raster in global.css prijs en knop in de rechterkolom. -->
        <div class="info">
          <h3>{uitgelicht.titel}</h3>
          <div class="prijs">{euro(uitgelicht.prijs)}</div>
          <div class="plaats">{uitgelicht.plaats}</div>
          <div class="meta">
            {[cijfer(uitgelicht.slaapkamers, w('slaapkamers').toLowerCase()), cijfer(uitgelicht.badkamers, w('badkamers').toLowerCase()),
              cijfer(uitgelicht.woonoppervlak, 'm²')].filter(Boolean).map((r) => <span>{r}</span>)}
          </div>
          <a class="go" href={a(`/woning/${uitgelicht.slug}/`)}>{t('woningen_link')}</a>
        </div>
      </div>
    )}

    {overige.length > 0 && (
      <div class="reveal">
        <div style="text-align:center;margin:8px 0 30px">
          <span class="eyebrow">{t('woningen_meer')}</span>
        </div>
        <div class="woningen-grid">
          {/* `x` en niet `w`: `w` is hierboven al de woordenlijst. */}
          {overige.map((x) => (
            <a class={`card${rustigKlasse(weergave, isAfgerond(x.status))}`} href={a(`/woning/${x.slug}/`)}>
              <div class="img">
                <img src={x.hero} alt={x.titel} loading="lazy" onerror="this.remove()" />
                {statusVan(x.status) && (
                  <span class={`status ${statusVan(x.status).klasse}`}>{statusVan(x.status).kort}</span>
                )}
              </div>
              <div class="body">
                <h3>{x.titel}</h3>
                <div class="plaats">{x.plaats}</div>
                <div class="meta">
                  {[cijfer(x.slaapkamers, w('slk')), cijfer(x.badkamers, w('bad')),
                    cijfer(x.woonoppervlak, 'm²')].filter(Boolean).map((r) => <span>{r}</span>)}
                </div>
                <div class="prijs">{euro(x.prijs)}</div>
                <div class="link">{t('woningen_link')}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {alle.length === 0 && (
      <p class="reveal" style="text-align:center;color:var(--muted)">
        Nog geen woningen toegevoegd. Voeg de eerste toe via <a href="/beheer/">het beheer-dashboard</a>.
      </p>
    )}
  </div>
</section>
