---
// Teksten komen uit het dashboard (met de standaard uit public/teksten.json
// als vangnet). Beeld en opmaak liggen vast.
import { tekst, mailLink, whatsappLink, telLink } from '../../lib/teksten.js';
const { teksten = {} } = Astro.props;
const t = (id) => tekst(teksten, id);
---
<!-- FOTOGRAFIE -->
<section class="pad foto" id="fotografie" data-sectie="fotografie">
  <div class="wrap">
    <div class="ph reveal" style="background:linear-gradient(135deg,var(--accent-soft),var(--accent2))">
      <img class="photo" src="/caro-fotografie.jpg" alt="Caro Leriche aan het fotograferen" onerror="this.remove()" />
    </div>
    <div class="reveal">
      <div class="eyebrow">{t('fotografie_eyebrow')}</div>
      <h2>{t('fotografie_kop')}</h2>
      <p>{t('fotografie_tekst')}</p>
      <div class="btns">
        <a class="btn btn-primary" href={mailLink(teksten, 'Fotografie')}>{t('fotografie_knop')}</a>
      </div>
    </div>
  </div>
</section>
