---
// Header met grote foto. De teksten komen uit het dashboard; beeld en opmaak
// liggen vast. Caro kan de sectie via het dashboard aan- of uitzetten.
import { tekst } from '../../lib/teksten.js';
const { teksten = {} } = Astro.props;
const t = (id) => tekst(teksten, id);
const homeHero = 'https://images.unsplash.com/photo-1613490493576-7fde63acd811?auto=format&fit=crop&w=1900&q=70';
---
<!-- HOME HERO -->
<section class="home-hero" data-sectie="hero">
  <div class="ph kenburns" style="background:linear-gradient(120deg,var(--accent-soft),var(--sand-deep))">
    <img class="photo" src={homeHero} alt="Spanje" onerror="this.remove()" />
  </div>
  <div class="wrap">
    <div class="inner">
      <div class="eyebrow" style="color:var(--sand-deep)">{t('hero_eyebrow')}</div>
      <h1 style="font-size:clamp(2.2rem,4.6vw,3.5rem)">{t('hero_kop')}</h1>
      <p style="font-size:1rem;max-width:430px;opacity:.92">{t('hero_tekst')}</p>
      <div class="btns">
        <a class="btn btn-primary" href="#contact">{t('hero_knop')}</a>
      </div>
    </div>
  </div>
</section>
