---
import '../styles/global.css';
import { paletCss } from '../lib/palet.js';
import { getInstellingen } from '../lib/instellingen';

// Het kleurpalet dat Caro in het dashboard koos. Bij een onbereikbare database
// valt dit terug op de huisstijl, dus de site ziet er altijd goed uit.
const instellingen = await getInstellingen();

const {
  title = 'Caro Leriche — Real Estate Spain',
  description = 'Persoonlijk en exclusief vastgoed in Spanje. Caro Leriche begeleidt kopers bij het vinden van hun plek in de zon — en fotografeert de woningen zelf.',
  nav = 'full',
  theme = 'light',
} = Astro.props;
const SITE_VERSION = 'v1.15';

// ⚙️ KEUZE CARO — cirkel rond het CL-logo in het menu.
//    'geen' · 'fijn' (dun, zacht) · 'feller' (dikker, teal) · 'fel' (dik, vol teal)
const CL_CIRKEL = 'feller';
const favicon = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20rx='12'%20fill='%232A7385'/%3E%3Ctext%20x='32'%20y='45'%20font-family='Georgia,serif'%20font-size='32'%20fill='white'%20text-anchor='middle'%3ECL%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Inter:wght@300;400;500;600&family=Noto+Serif+Display:wdth,wght@62.5..100,400..600&display=swap" rel="stylesheet" />
  <!-- Gekozen kleurpalet. Staat bewust ná de stylesheet, zodat het de
       standaardkleuren in global.css overschrijft. -->
  <style is:inline set:html={paletCss(instellingen.palet)}></style>
</head>
<body class={theme === 'dark' ? 'theme-dark' : undefined}>
  <header class="top">
    <div class="wrap">
      <a class={CL_CIRKEL === 'geen' ? 'brand' : `brand circled c-${CL_CIRKEL}`} href="/">
        <img class="brandlogo" src="/logo-cl.png" alt="Caro Leriche" />
        <span class="name">Caro Leriche<small>Real Estate Spain</small></span>
      </a>
      {nav === 'full' ? (
        <Fragment>
          <nav>
            <a href="/#woningen">Woningen</a>
            <a href="/#fotografie">Fotografie</a>
            <a href="/#over">Over Caro</a>
            <a href="/#contact">Contact</a>
            <a class="cta" href="/#contact">Plan bezichtiging</a>
          </nav>
          <button class="burger" aria-label="menu" type="button" onclick="var n=document.querySelector('.top nav');n.style.display=(getComputedStyle(n).display==='none'?'flex':'none')">☰</button>
        </Fragment>
      ) : (
        <nav><a class="cta" href="https://wa.me/34604272907">WhatsApp Caro</a></nav>
      )}
    </div>
  </header>

  <slot />

  <footer class="site">
    <div class="wrap">
      <div class="fname">Caro Leriche</div>
      <div>Real Estate Spain</div>
      <div>RAICV 3994 · © 2026 Caro Leriche</div>
      <div style="opacity:.5;font-size:.72rem;letter-spacing:.12em;width:100%;text-align:center;margin-top:6px">{SITE_VERSION}</div>
      <a href="/beheer/" class="beheer-link" aria-label="Inloggen (beheer)" title="Beheer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
      </a>
    </div>
  </footer>
  <style>
    .beheer-link{opacity:.25;color:inherit;display:inline-flex;width:100%;justify-content:center;margin-top:12px;transition:opacity .2s}
    .beheer-link:hover{opacity:.7}
  </style>

  <script is:inline>
    var io = new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}})},{threshold:.12});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)});
    document.querySelectorAll('.typed').forEach(function(el){
      var t = el.getAttribute('data-text') || '', i = 0;
      (function tick(){ el.textContent = t.slice(0,i); if(i++ < t.length) setTimeout(tick, 95); })();
    });
    var sb = document.querySelector('.soundbtn'), v = document.querySelector('.bgvid');
    if (sb) sb.addEventListener('click', function(){
      var on = sb.classList.toggle('on');
      if (v) v.muted = !on;
      sb.textContent = on ? '🔊 geluid aan' : '🔈 tik voor geluid';
    });
  </script>
</body>
</html>
