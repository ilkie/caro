---
import '../styles/global.css';
import { paletCss, lettertypeUrl } from '../lib/palet.js';
import { getInstellingen } from '../lib/instellingen';
import { tekst, whatsappLink, copyrightRegel, JURIDISCH,
         TALEN, STANDAARD_TAAL, schoneTaal, link } from '../lib/teksten.js';
import { logoAttributen } from '../lib/logo.js';

// Het kleurpalet dat Caro in het dashboard koos. Bij een onbereikbare database
// valt dit terug op de huisstijl, dus de site ziet er altijd goed uit.
const {
  title = 'Caro Leriche — Real Estate Spain',
  description = 'Persoonlijk en exclusief vastgoed in Spanje. Caro Leriche begeleidt kopers bij het vinden van hun plek in de zon — en fotografeert de woningen zelf.',
  nav = 'full',
  theme = 'light',
  // De taal van deze pagina, en het adres zónder taalvoorvoegsel — dat laatste
  // heeft de taalwissel nodig om naar dezelfde pagina in een andere taal te
  // kunnen springen.
  taal: taalRuw = STANDAARD_TAAL,
  pad = '/',
} = Astro.props;
const taal = schoneTaal(taalRuw);

const instellingen = await getInstellingen(taal);
const t = (id) => tekst(instellingen.teksten, id);
const a = (naar) => link(taal, naar);

const SITE_VERSION = 'v1.38';

// Jaartal komt uit de bouwdatum, zodat het na de jaarwisseling vanzelf klopt.
const JAAR = new Date().getFullYear();

// Het logo in het menu: bron, vorm, formaat en wat ernaast staat komen uit het
// dashboard (Vormgeving → Logo). Zie src/lib/logo.js voor de terugvallen.
const merk = logoAttributen(instellingen.logo);
const favicon = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20rx='12'%20fill='%232A7385'/%3E%3Ctext%20x='32'%20y='45'%20font-family='Georgia,serif'%20font-size='32'%20fill='white'%20text-anchor='middle'%3ECL%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang={taal}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <!-- Zelfde pagina, andere taal. x-default wijst naar de standaardtaal. -->
  {TALEN.map((x) => <link rel="alternate" hreflang={x.id} href={link(x.id, pad)} />)}
  <link rel="alternate" hreflang="x-default" href={link(STANDAARD_TAAL, pad)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={lettertypeUrl(instellingen.lettertype)} rel="stylesheet" />
  <!-- Gekozen kleurpalet. Staat bewust ná de stylesheet, zodat het de
       standaardkleuren in global.css overschrijft. -->
  <style is:inline set:html={paletCss(instellingen.palet, instellingen.keuzes, instellingen.lettertype)}></style>
</head>
<body class={theme === 'dark' ? 'theme-dark' : undefined}>
  <header class="top">
    <div class="wrap">
      <a class={merk.klasse} style={merk.stijl} href={a('/')}>
        <img class="brandlogo" src={merk.url} alt={t('footer_naam')} />
        {merk.toonNaam && (
          <span class="name">{t('footer_naam')}{merk.toonOndertitel && <small>{t('footer_regel')}</small>}</span>
        )}
      </a>
      {nav === 'full' ? (
        <Fragment>
          <nav>
            <a href={a('/#woningen')}>{t('menu_woningen')}</a>
            <a href={a('/#fotografie')}>{t('menu_fotografie')}</a>
            <a href={a('/#over')}>{t('menu_over')}</a>
            <a href={a('/#contact')}>{t('menu_contact')}</a>
            <a class="cta" href={a('/#contact')}>{t('menu_knop')}</a>
          </nav>
          <div class="taalwissel">
        {TALEN.map((x) => (
          <a href={link(x.id, pad)} hreflang={x.id} lang={x.id}
             class={x.id === taal ? 'nu' : undefined}
             aria-current={x.id === taal ? 'true' : undefined}
             title={x.naam}>{x.kort}</a>
        ))}
      </div>
          <button class="burger" aria-label="menu" type="button" onclick="var n=document.querySelector('.top nav');n.style.display=(getComputedStyle(n).display==='none'?'flex':'none')">☰</button>
        </Fragment>
      ) : (
        <Fragment>
          <div class="taalwissel">
        {TALEN.map((x) => (
          <a href={link(x.id, pad)} hreflang={x.id} lang={x.id}
             class={x.id === taal ? 'nu' : undefined}
             aria-current={x.id === taal ? 'true' : undefined}
             title={x.naam}>{x.kort}</a>
        ))}
      </div>
          <nav><a class="cta" href={whatsappLink(instellingen.teksten)}>{t('menu_knop_woning')}</a></nav>
        </Fragment>
      )}
    </div>
  </header>

  <slot />

  <footer class="site">
    <div class="wrap">
      <div class="fname">{t('footer_naam')}</div>
      <div>{t('footer_regel')}</div>
      <div>{t('footer_raicv')}</div>
      <div class="juridisch">
        <span>{copyrightRegel(instellingen.teksten, JAAR)}</span>
        {JURIDISCH.map((p) => <a href={a(`/${p.slug}/`)}>{p.titel}</a>)}
      </div>
      <div class="bouwer">© {JAAR} Mephio Webtools · {SITE_VERSION}</div>
      <a href="/beheer/" class="beheer-link" aria-label="Inloggen (beheer)" title="Beheer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
      </a>
    </div>
  </footer>
  <style>
    /* De taalwissel: drie korte codes, de huidige taal opgelicht. Bewust geen
       vlaggetjes — een vlag is een land en geen taal, en Engels heeft er drie
       die evenveel recht hebben. */
    .taalwissel{display:flex;align-items:center;gap:2px;font-size:.68rem;letter-spacing:.1em}
    .taalwissel a{padding:6px 8px;border-radius:var(--r-pill);color:var(--muted);transition:.15s}
    .taalwissel a:hover{color:var(--accent);background:var(--sand)}
    .taalwissel a.nu{color:var(--accent);font-weight:600}
    .theme-dark .taalwissel a{color:var(--cream-70)}
    .theme-dark .taalwissel a:hover{color:#fff;background:rgba(255,255,255,.12)}
    .theme-dark .taalwissel a.nu{color:#fff}
    @media (max-width:900px){ .taalwissel{margin-left:auto;margin-right:6px} }
    /* De juridische regel: de punten zijn scheidingstekens tussen de links, dus
       ze horen bij de opmaak en niet in de tekst — anders leest een schermlezer
       ze mee op. Vandaar `::before` in plaats van een punt in de HTML. */
    .juridisch{display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;
      gap:2px 0;width:100%;margin-top:10px;font-size:.8rem;opacity:.85}
    .juridisch a{color:inherit;text-decoration:none;border-bottom:1px solid transparent;transition:border-color .2s}
    .juridisch a:hover{border-bottom-color:currentColor}
    .juridisch a::before{content:'·';opacity:.55;margin:0 9px}
    .bouwer{opacity:.5;font-size:.72rem;letter-spacing:.12em;width:100%;text-align:center;margin-top:6px}
    .beheer-link{opacity:.25;color:inherit;display:inline-flex;width:100%;justify-content:center;margin-top:12px;transition:opacity .2s}
    .beheer-link:hover{opacity:.7}
  </style>

  <script is:inline>
    var io = new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}})},{threshold:.12});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)});
    document.querySelectorAll('.typed').forEach(function(el){
      var t = el.getAttribute('data-text') || '', i = 0;
      (function tick(){ el.textContent = t.slice(0,i); if(i++ < t.length) setTimeout(tick, 95); })();
    });
    var sb = document.querySelector('.soundbtn'), v = document.querySelector('.bgvid');
    if (sb) sb.addEventListener('click', function(){
      var on = sb.classList.toggle('on');
      if (v) v.muted = !on;
      sb.textContent = on ? '🔊 geluid aan' : '🔈 tik voor geluid';
    });
  </script>
</body>
</html>
