---
import Base from '../../layouts/Base.astro';
import { getAlleWoningen } from '../../lib/supabase';

export async function getStaticPaths() {
  const woningen = await getAlleWoningen();
  return woningen.map((w) => ({ params: { slug: w.slug }, props: { woning: w } }));
}

const { woning: d } = Astro.props;
const euro = (n) => '€ ' + (n ?? 0).toLocaleString('nl-NL');
const galerij = d.galerij || [];
const kenmerkenBinnen = d.kenmerken_binnen || [];
const kenmerkenBuiten = d.kenmerken_buiten || [];
const afstanden = d.afstanden || [];
const alineas = (d.omschrijving || '').split(/\n{2,}|\n/).map((s) => s.trim()).filter(Boolean);
const heeftVideo = !!(d.video && d.video.length > 0);
const pageTitle = `${d.titel}, ${d.plaats} — ${d.status} | Caro Leriche`;
const pageDesc = `${d.titel} in ${d.plaats} (${d.regio}): ${d.slaapkamers} slaapkamers, ${d.woonoppervlak} m². Persoonlijk begeleid door Caro Leriche, Real Estate Spain.`;
const tegelClass = (i) => (i % 5 === 4 ? 't-full' : i % 2 === 0 ? 't-wide' : 't-tall');
---
<Base title={pageTitle} description={pageDesc} nav="minimal" theme="dark">
  <!-- VIDEO-HERO (kleiner, met fijn kader) -->
  <section class="wp-hero" id="top">
    <div class="wrap">
      <div class="frame">
        <div class="stage">
          {d.hero && <img src={d.hero} alt={d.titel} onerror="this.remove()" />}
          {heeftVideo && (
            <video class="bgvid" autoplay muted loop playsinline poster={d.hero}>
              <source src={d.video} type="video/mp4" />
            </video>
          )}
        </div>
      </div>
      <h1 class="naam"><span class="typed" data-text={d.titel}></span><span class="caret"></span></h1>
      <div class="prijs">{euro(d.prijs)}</div>
      <div class="sub">{d.status} · {d.plaats}{d.regio ? `, ${d.regio}` : ''}</div>
      {heeftVideo && <button class="soundbtn" type="button" aria-label="Geluid aan of uit">🔈 tik voor geluid</button>}
    </div>
  </section>

  <!-- FEITEN (los, dunne lijn) -->
  <section class="facts">
    <div class="wrap">
      <div class="f"><div class="n">{d.slaapkamers}</div><div class="l">Slaapkamers</div></div>
      <div class="f"><div class="n">{d.badkamers}</div><div class="l">Badkamers</div></div>
      <div class="f"><div class="n">{d.woonoppervlak}</div><div class="l">m² woonopp.</div></div>
      <div class="f"><div class="n">{d.perceel}</div><div class="l">m² perceel</div></div>
      <div class="f"><div class="n">{d.bouwjaar}</div><div class="l">Bouwjaar</div></div>
    </div>
  </section>

  <!-- VERHAAL -->
  <section class="pad">
    <div class="wrap lead reveal">
      <div class="eyebrow">Welkom thuis</div>
      <h2>{d.titel}</h2>
      {alineas.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- EDITORIAL GALERIJ -->
  {galerij.length > 0 && (
    <section style="padding:20px 0 90px">
      <div class="wrap" style="margin-bottom:22px"><div class="eyebrow">Beeld</div></div>
      <div class="wp-gal">
        {galerij.map((g, i) => (
          <div class={`wp-tile ${tegelClass(i)}`}>
            {g.src && <img src={g.src} alt={g.label || d.titel} loading="lazy" onerror="this.style.opacity=0" />}
            {g.label && <span>{g.label}</span>}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- KENMERKEN -->
  <section class="pad feat">
    <div class="wrap reveal">
      <div class="section-head">
        <div class="eyebrow">Kenmerken</div>
        <h2>Alles wat deze woning bijzonder maakt</h2>
      </div>
      <div class="feat-grid">
        <div class="col">
          <h3>Binnen</h3>
          <ul>{kenmerkenBinnen.map((k) => <li>{k}</li>)}</ul>
        </div>
        <div class="col">
          <h3>Buiten</h3>
          <ul>{kenmerkenBuiten.map((k) => <li>{k}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- LOCATIE -->
  {afstanden.length > 0 && (
    <section class="pad">
      <div class="wrap loc-grid reveal">
        <div class="ph" style="background:linear-gradient(135deg,#123039,#0b2027)">
          <!-- ✎ VUL IN: vervang door een Google Maps-embed -->
          <span class="tag">Kaart / locatie</span>
        </div>
        <div>
          <div class="eyebrow">Locatie</div>
          <h2 style="font-size:clamp(1.7rem,3vw,2.3rem);font-weight:400;margin:.3em 0 .5em">{d.plaats}</h2>
          <p>Rustig gelegen, met alles binnen handbereik.</p>
          <div class="dist">
            {afstanden.map((a) => (
              <div class="d"><span>{a.plek}</span><span>{a.tijd}</span></div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CONTACT -->
  <section class="pad contact">
    <div class="wrap">
      <div class="agent-card">
        <div class="agent-photo"><img src="/logo-cl.png" alt="Caro Leriche" /></div>
        <div>
          <h3>Caro Leriche</h3>
          <div style="opacity:.85;font-size:.9rem;margin-top:4px">Real Estate Spain</div>
        </div>
      </div>
      <div>
        <h2>Deze woning met eigen ogen zien?</h2>
        <p>Ik begeleid je persoonlijk — plan een vrijblijvende bezichtiging, ter plaatse of via een videorondleiding.</p>
        <div class="btns">
          <a class="btn btn-primary" href="https://wa.me/34604272907">WhatsApp Caro</a>
          <a class="btn btn-ghost" href="mailto:caro.realestate.spain@gmail.com">Stuur een e-mail</a>
          <a class="btn btn-ghost" href="tel:+34604272907">+34 604 27 29 07</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PERSOONLIJK (footer-quote, alleen woningpagina) -->
  <section class="wp-personal">
    <div class="wrap">
      <img class="portret" src="/caro-portret.jpg" alt="Caro Leriche" onerror="this.remove()" />
      <blockquote>“Seeing clients super happy makes my heart jump.”</blockquote>
      <div class="ondertekening">Caro Leriche</div>
    </div>
  </section>
</Base>
