---
import Base from '../layouts/Base.astro';
import { getWoningen } from '../lib/supabase';

const alle = await getWoningen();

const uitgelicht = alle.find((w) => w.uitgelicht) || alle[0];
const overige = alle.filter((w) => !uitgelicht || w.slug !== uitgelicht.slug);

const euro = (n) => '€ ' + (n ?? 0).toLocaleString('nl-NL');
const homeHero = 'https://images.unsplash.com/photo-1613490493576-7fde63acd811?auto=format&fit=crop&w=1900&q=70';
---
<Base>
  <!-- HOME HERO -->
  <section class="home-hero">
    <div class="ph kenburns" style="background:linear-gradient(120deg,#2A7385,#EBC79C)">
      <img class="photo" src={homeHero} alt="Spanje" onerror="this.remove()" />
    </div>
    <div class="wrap">
      <div class="inner">
        <div class="eyebrow" style="color:#f0dccd">Real Estate Spain</div>
        <h1>Vind jouw plek in de zon</h1>
        <p>Persoonlijk en exclusief. Ik help je bij het vinden — en kopen — van de juiste woning in Spanje, van eerste video tot de sleutel.</p>
        <div class="btns">
          <a class="btn btn-primary" href="#contact">Neem contact op</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WONINGEN: uitgelicht + overzicht -->
  <section class="pad" id="woningen">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">In de spotlight</div>
        <h2>Woning in de kijker</h2>
      </div>

      {uitgelicht && (
        <div class="spotlight reveal">
          <a href={`/woning/${uitgelicht.slug}/`} class="img">
            <img src={uitgelicht.hero} alt={uitgelicht.titel} onerror="this.remove()" />
            <span class="badge">{uitgelicht.status}</span>
          </a>
          <div class="info">
            <div>
              <h3>{uitgelicht.titel}</h3>
              <div class="plaats">{uitgelicht.plaats}</div>
              <div class="meta">
                <span>{uitgelicht.slaapkamers} slaapkamers</span>
                <span>{uitgelicht.badkamers} badkamers</span>
                <span>{uitgelicht.woonoppervlak} m²</span>
              </div>
            </div>
            <div class="right">
              <div class="prijs">{euro(uitgelicht.prijs)}</div>
              <a class="go" href={`/woning/${uitgelicht.slug}/`}>Bekijk woning →</a>
            </div>
          </div>
        </div>
      )}

      {overige.length > 0 && (
        <div class="reveal">
          <div style="text-align:center;margin:8px 0 30px">
            <span class="eyebrow">Meer woningen</span>
          </div>
          <div class="woningen-grid">
            {overige.map((w) => (
              <a class="card" href={`/woning/${w.slug}/`}>
                <div class="img">
                  <img src={w.hero} alt={w.titel} loading="lazy" onerror="this.remove()" />
                  <span class="status">{w.status}</span>
                </div>
                <div class="body">
                  <h3>{w.titel}</h3>
                  <div class="plaats">{w.plaats}</div>
                  <div class="meta">
                    <span>{w.slaapkamers} slk</span>
                    <span>{w.badkamers} bad</span>
                    <span>{w.woonoppervlak} m²</span>
                  </div>
                  <div class="prijs">{euro(w.prijs)}</div>
                  <div class="link">Bekijk woning →</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {alle.length === 0 && (
        <p class="reveal" style="text-align:center;color:var(--muted)">
          Nog geen woningen toegevoegd. Voeg de eerste toe via <a href="/beheer/">het beheer-dashboard</a>.
        </p>
      )}
    </div>
  </section>

  <!-- FOTOGRAFIE -->
  <section class="pad foto" id="fotografie">
    <div class="wrap">
      <div class="ph reveal" style="background:linear-gradient(135deg,#2A7385,#B15B3C)">
        <!-- ✎ VUL IN: een sfeer- of fotografiebeeld van Caro -->
      </div>
      <div class="reveal">
        <div class="eyebrow">Ook fotografie</div>
        <h2>Ik fotografeer en film de woningen zelf</h2>
        <p>Geen standaard makelaarskiekjes: elke woning leg ik vast met oog voor licht, sfeer en verhaal — in foto én video. Wil je jouw woning zo in beeld gebracht zien? Vraag gerust naar de mogelijkheden.</p>
        <div class="btns">
          <a class="btn btn-primary" href="mailto:caro@example.com?subject=Fotografie">Vraag naar fotografie</a>
        </div>
      </div>
    </div>
  </section>

  <!-- OVER CARO -->
  <section class="pad about" id="over">
    <div class="wrap">
      <div class="ph reveal" style="background:linear-gradient(135deg,#1E5A69,#7C8368)">
        <img class="photo" src="/caro.jpg" alt="Caro Leriche" onerror="this.remove()" />
      </div>
      <div class="reveal">
        <div class="eyebrow">Over Caro</div>
        <h2>Een makelaar die je écht leert kennen</h2>
        <p>Ik geloof niet in eindeloze lijstjes met identieke pandjes. Ik werk persoonlijk, met oog voor beeld en verhaal, en begeleid je van de eerste kennismaking tot ver na de aankoop.</p>
        <p>Op zoek naar een woning, of denk je aan bouwen in Spanje? Laten we kennismaken — dan zoek ik gericht met je mee.</p>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="pad contact" id="contact">
    <div class="wrap">
      <div class="agent-card">
        <div class="agent-photo"></div>
        <div>
          <div class="role">Jouw makelaar</div>
          <h3>Caro Leriche</h3>
          <div style="opacity:.85;font-size:.9rem;margin-top:4px">Real Estate Spain</div>
        </div>
      </div>
      <div>
        <h2>Op zoek naar jouw woning in Spanje?</h2>
        <p>Vertel me waar je naar zoekt — ik begeleid je persoonlijk, ook als de juiste woning nog gevonden moet worden.</p>
        <div class="btns">
          <!-- ✎ VUL IN: echte gegevens -->
          <a class="btn btn-primary" href="https://wa.me/34600000000">WhatsApp Caro</a>
          <a class="btn btn-ghost" href="mailto:caro@example.com">Stuur een e-mail</a>
          <a class="btn btn-ghost" href="tel:+34600000000">+34 600 000 000</a>
        </div>
      </div>
    </div>
  </section>
</Base>
