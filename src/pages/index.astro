---
import Base from '../layouts/Base.astro';
import { getWoningen } from '../lib/supabase';
import { getInstellingen } from '../lib/instellingen';

import Hero from '../components/secties/Hero.astro';
import Woningen from '../components/secties/Woningen.astro';
import Fotografie from '../components/secties/Fotografie.astro';
import Over from '../components/secties/Over.astro';
import Contact from '../components/secties/Contact.astro';
import { logoAttributen } from '../lib/logo.js';

const alle = await getWoningen();
const { secties, teksten, logo } = await getInstellingen();

// Welke sectie hoort bij welk component. Staat een id hier niet in, dan wordt
// hij overgeslagen — zo kan een oude instelling de pagina nooit slopen.
const componenten = {
  hero: Hero,
  woningen: Woningen,
  fotografie: Fotografie,
  over: Over,
  contact: Contact,
};

const zichtbaar = secties.filter((s) => s.aan && componenten[s.id]);
const merkUrl = logoAttributen(logo).url;
---
<Base>
  {zichtbaar.map((s) => {
    const Sectie = componenten[s.id];
    return <Sectie alle={alle} teksten={teksten} merkUrl={merkUrl} />;
  })}
</Base>
