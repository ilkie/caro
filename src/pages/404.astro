---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina niet gevonden — Caro Leriche">
  <section class="err">
    <div class="big">404</div>
    <h1>Deze pagina bestaat niet (meer)</h1>
    <p>Misschien is de woning al verkocht, of klopte de link niet helemaal.</p>
    <div class="btns">
      <a class="btn btn-primary" href="/" style="background:var(--teal);color:#fff">Terug naar home</a>
      <a class="btn btn-ghost" href="/#woningen" style="border-color:var(--line);color:var(--teal)">Bekijk de woningen</a>
    </div>
  </section>
</Base>
